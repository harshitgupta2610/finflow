// FinFlow Production Database Schema
// Database Engine: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. ORGANIZATION & MULTI-TENANCY
// -------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies   Company[]
  users       User[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Company {
  id                    String   @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName             String
  displayName           String
  pan                   String?
  gstin                 String?
  address               String?
  state                 String?
  pincode               String?
  email                 String?
  phone                 String?
  logo                  String?
  currency              String   @default("INR")
  activeFinancialYearId String?  @unique
  taxConfig             Json?
  invoiceConfig         Json?
  bankDetails           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  branches              Branch[]
  financialYears        FinancialYear[]
  userRoles             UserRole[]
  auditLogs             AuditLog[]
  accountGroups         AccountGroup[]
  accounts              Account[]
  parties               Party[]
  items                 Item[]
  vouchers              Voucher[]
  journalEntries        JournalEntry[]
  salesInvoices         SalesInvoice[]
  purchaseInvoices      PurchaseInvoice[]
  quotations            Quotation[]
  salesOrders           SalesOrder[]
  purchaseOrders        PurchaseOrder[]

  @@map("companies")
}

model Branch {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  code         String
  address      String?
  gstin        String?
  isHeadOffice Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  journalLines JournalEntryLine[]

  @@unique([companyId, code])
  @@map("branches")
}

model FinancialYear {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String   // e.g. "FY 2024-25"
  startDate   DateTime
  endDate     DateTime
  isLocked    Boolean  @default(false)
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journalEntries   JournalEntry[]
  vouchers         Voucher[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]

  @@unique([companyId, name])
  @@map("financial_years")
}

// -------------------------------------------------------------
// 2. USERS, ROLES & SECURITY
// -------------------------------------------------------------

model User {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isActive       Boolean  @default(true)
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userRoles        UserRole[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  createdVouchers  Voucher[] @relation("VoucherCreatedBy")
  approvedVouchers Voucher[] @relation("VoucherApprovedBy")

  @@map("users")
}

enum RoleName {
  OWNER
  ADMIN
  ACCOUNTANT
  SALES
  PURCHASE
  INVENTORY_MANAGER
  AUDITOR
  VIEWER
}

model Role {
  id          String    @id @default(uuid())
  name        RoleName  @unique
  description String?
  isSystem    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "company.read", "sales.create"
  description String?
  module      String   // e.g. "Sales", "Accounting", "Company"
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("refresh_tokens")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String       // e.g. "AUTH_LOGIN", "COMPANY_CREATE", "VOUCHER_CANCEL"
  entity         String       // e.g. "User", "Voucher", "Company"
  entityId       String?
  beforeState    Json?
  afterState     Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@map("audit_logs")
}

// -------------------------------------------------------------
// 3. CHART OF ACCOUNTS & DOUBLE-ENTRY ACCOUNTING
// -------------------------------------------------------------

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BalanceType {
  DEBIT
  CREDIT
}

model AccountGroup {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String
  category    AccountCategory
  parentId    String?
  parent      AccountGroup?   @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    AccountGroup[]  @relation("GroupHierarchy")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  accounts    Account[]

  @@unique([companyId, code])
  @@map("account_groups")
}

model Account {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountGroupId     String
  accountGroup       AccountGroup @relation(fields: [accountGroupId], references: [id], onDelete: Restrict)
  name               String
  code               String
  openingBalance     Decimal      @default(0.0000) @db.Decimal(18, 4)
  openingBalanceType BalanceType  @default(DEBIT)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  journalLines       JournalEntryLine[]

  @@unique([companyId, code])
  @@map("accounts")
}

// -------------------------------------------------------------
// 4. PARTIES & ITEMS (MASTERS)
// -------------------------------------------------------------

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Party {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  partyType       PartyType @default(CUSTOMER)
  gstin           String?
  pan             String?
  phone           String?
  email           String?
  billingAddress  String?
  shippingAddress String?
  state           String?
  pincode         String?
  creditLimit     Decimal?  @db.Decimal(18, 4)
  creditDays      Int?
  openingBalance  Decimal   @default(0.0000) @db.Decimal(18, 4)
  bankDetails     Json?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  journalLines     JournalEntryLine[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]

  @@map("parties")
}

model Item {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  sku           String
  hsnSac        String?
  category      String?
  unit          String   @default("PCS")
  gstRate       Decimal  @default(18.00) @db.Decimal(5, 2)
  purchasePrice Decimal  @default(0.0000) @db.Decimal(18, 4)
  sellingPrice  Decimal  @default(0.0000) @db.Decimal(18, 4)
  mrp           Decimal? @db.Decimal(18, 4)
  reorderLevel  Decimal? @db.Decimal(18, 4)
  barcode       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesLines    SalesInvoiceLine[]
  purchaseLines PurchaseInvoiceLine[]

  @@unique([companyId, sku])
  @@map("items")
}

// -------------------------------------------------------------
// 5. VOUCHERS & JOURNAL ENTRIES
// -------------------------------------------------------------

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  JOURNAL
  CONTRA
  DEBIT_NOTE
  CREDIT_NOTE
}

enum VoucherStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CANCELLED
  REJECTED
}

model Voucher {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  voucherType     VoucherType
  voucherNumber   String
  date            DateTime
  narration       String?
  status          VoucherStatus @default(APPROVED)
  createdById     String
  createdBy       User          @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?         @relation("VoucherApprovedBy", fields: [approvedById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  journalEntry     JournalEntry?
  salesInvoice     SalesInvoice?
  purchaseInvoice  PurchaseInvoice?

  @@unique([companyId, financialYearId, voucherType, voucherNumber])
  @@map("vouchers")
}

model JournalEntry {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  voucherId       String        @unique
  voucher         Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  date            DateTime
  narration       String?
  isReversal      Boolean       @default(false)
  reversalOfId    String?
  createdAt       DateTime      @default(now())

  lines           JournalEntryLine[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal      @default(0.0000) @db.Decimal(18, 4)
  credit         Decimal      @default(0.0000) @db.Decimal(18, 4)
  partyId        String?
  party          Party?       @relation(fields: [partyId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("journal_entry_lines")
}

// -------------------------------------------------------------
// 6. SALES MODULE (INVOICES, QUOTATIONS, ORDERS)
// -------------------------------------------------------------

enum PaymentMode {
  CASH
  BANK
  CREDIT
  UPI
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SalesInvoice {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  voucherId       String        @unique
  voucher         Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  customerId      String
  customer        Party         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  placeOfSupply   String?
  isTaxInclusive  Boolean       @default(false)
  paymentMode     PaymentMode   @default(CREDIT)
  status          InvoiceStatus @default(UNPAID)
  
  subtotal        Decimal       @db.Decimal(18, 4)
  discountTotal   Decimal       @default(0.0000) @db.Decimal(18, 4)
  cgstTotal       Decimal       @default(0.0000) @db.Decimal(18, 4)
  sgstTotal       Decimal       @default(0.0000) @db.Decimal(18, 4)
  igstTotal       Decimal       @default(0.0000) @db.Decimal(18, 4)
  freightCharges  Decimal       @default(0.0000) @db.Decimal(18, 4)
  roundOff        Decimal       @default(0.0000) @db.Decimal(18, 4)
  totalAmount     Decimal       @db.Decimal(18, 4)
  notes           String?
  createdAt       DateTime      @default(now())

  lines           SalesInvoiceLine[]

  @@unique([companyId, financialYearId, invoiceNumber])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id             String       @id @default(uuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(18, 4)
  unitPrice      Decimal      @db.Decimal(18, 4)
  discount       Decimal      @default(0.0000) @db.Decimal(18, 4)
  gstRate        Decimal      @default(18.00) @db.Decimal(5, 2)
  taxableAmount  Decimal      @db.Decimal(18, 4)
  cgst           Decimal      @default(0.0000) @db.Decimal(18, 4)
  sgst           Decimal      @default(0.0000) @db.Decimal(18, 4)
  igst           Decimal      @default(0.0000) @db.Decimal(18, 4)
  total          Decimal      @db.Decimal(18, 4)

  @@map("sales_invoice_lines")
}

model Quotation {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  quotationNo     String
  date            DateTime
  validUntil      DateTime?
  customerId      String
  customer        Party         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalAmount     Decimal       @db.Decimal(18, 4)
  status          String        @default("SENT") // DRAFT, SENT, ACCEPTED, REJECTED
  createdAt       DateTime      @default(now())

  @@unique([companyId, quotationNo])
  @@map("quotations")
}

model SalesOrder {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  orderNumber     String
  date            DateTime
  customerId      String
  customer        Party         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalAmount     Decimal       @db.Decimal(18, 4)
  status          String        @default("CONFIRMED") // CONFIRMED, DISPATCHED, DELIVERED, CANCELLED
  createdAt       DateTime      @default(now())

  @@unique([companyId, orderNumber])
  @@map("sales_orders")
}

// -------------------------------------------------------------
// 7. PURCHASE MODULE
// -------------------------------------------------------------

model PurchaseInvoice {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  voucherId       String        @unique
  voucher         Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  supplierId      String
  supplier        Party         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  placeOfSupply   String?
  isTaxInclusive  Boolean       @default(false)
  paymentMode     PaymentMode   @default(CREDIT)
  status          InvoiceStatus @default(UNPAID)

  subtotal        Decimal       @db.Decimal(18, 4)
  discountTotal   Decimal       @default(0.0000) @db.Decimal(18, 4)
  inputCgst       Decimal       @default(0.0000) @db.Decimal(18, 4)
  inputSgst       Decimal       @default(0.0000) @db.Decimal(18, 4)
  inputIgst       Decimal       @default(0.0000) @db.Decimal(18, 4)
  freightCharges  Decimal       @default(0.0000) @db.Decimal(18, 4)
  roundOff        Decimal       @default(0.0000) @db.Decimal(18, 4)
  totalAmount     Decimal       @db.Decimal(18, 4)
  notes           String?
  createdAt       DateTime      @default(now())

  lines           PurchaseInvoiceLine[]

  @@unique([companyId, financialYearId, invoiceNumber])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity          Decimal         @db.Decimal(18, 4)
  unitPrice         Decimal         @db.Decimal(18, 4)
  discount          Decimal         @default(0.0000) @db.Decimal(18, 4)
  gstRate           Decimal         @default(18.00) @db.Decimal(5, 2)
  taxableAmount     Decimal         @db.Decimal(18, 4)
  inputCgst         Decimal         @default(0.0000) @db.Decimal(18, 4)
  inputSgst         Decimal         @default(0.0000) @db.Decimal(18, 4)
  inputIgst         Decimal         @default(0.0000) @db.Decimal(18, 4)
  total             Decimal         @db.Decimal(18, 4)

  @@map("purchase_invoice_lines")
}

model PurchaseOrder {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  orderNumber     String
  date            DateTime
  supplierId      String
  supplier        Party         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  totalAmount     Decimal       @db.Decimal(18, 4)
  status          String        @default("ISSUED") // ISSUED, RECEIVED, CANCELLED
  createdAt       DateTime      @default(now())

  @@unique([companyId, orderNumber])
  @@map("purchase_orders")
}
